# Configuração de Ambiente — VotaBrasil / MeuVoto
# Copie este arquivo para .env e preencha com seus valores de produção.

# Servidor e Porta
PORT=8080
NODE_ENV=production
BASE_URL=https://meu-voto.app

# Armazenamento (sqlite ou json)
MB_STORAGE=sqlite
MB_REFRESH_HOURS=24

# Segurança e Backups
BACKUP_TOKEN=sua_senha_secreta_para_backup_aqui
DIGEST_SECRET=chave_secreta_digest_semanal
COB_SECRET=chave_secreta_cobrancas

# Autenticação Google OAuth (Opcional)
GOOGLE_CLIENT_ID=seu_client_id_google.apps.googleusercontent.com
MB_AUTH_MODE=auto

# Web Push Notificações (Opcional)
VAPID_PUBLIC_KEY=sua_chave_publica_vapid

# Envio de E-mails / SMTP (Opcional - Nodemailer)
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_USER=usuario@seudominio.com
SMTP_PASS=sua_senha_smtp
SMTP_FROM=nao-responda@meu-voto.app

# SMS / WhatsApp via Twilio (Opcional - OTP)
TWILIO_ACCOUNT_SID=ac_seu_sid
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_PHONE=+5511999999999

# Sistema de Log Persistente (server/logger.js)
# LOG_FILE=1          → habilita escrita em server/data/logs/app.log (JSONL)
# LOG_LEVEL=info      → níveis: debug < info < warn < error
# LOG_DIR=caminho    → diretorio dos logs (default: server/data/logs)
# LOG_MAX_SIZE=10485760 → tamanho máximo do arquivo antes de rotacionar (default: 10 MB)
# LOG_MAX_FILES=5    → número máximo de arquivos retidos na rotação (default: 5)
LOG_FILE=1
LOG_LEVEL=info
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5
