# Cloudflare Pages / Netlify / Vercel redirects
# SPA fallback: Todas as rotas não-API vão para index.html
/*    /index.html   200

# Assets com cache longo
/assets/*    /assets/:splat    200
/images/*    /images/:splat    200

# API: serve diretamente pelo Railway (sem redirecionamento).
# O server/index.js expõe /api/health, /api/voto, etc. no mesmo domínio.
# Redirecionar /api/* para um subdomínio separado quebraria o healthcheck
# e forçaria dependência de domínio externo — evitado para garantir
# que /api/health fique sempre acessível e monitorado pelo Cloudflare.
# Se precisar de domínio dedicado para API, use um CNAME A/AAAA no DNS
# em vez de redirecionamento interno.